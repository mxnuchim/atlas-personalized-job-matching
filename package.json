{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "tsx src/db/status.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:profile": "tsx src/db/seed-profile.ts",
    "db:seed:sources": "tsx src/db/seed-sources.ts",
    "pipeline:run": "tsx --conditions=react-server src/pipeline/cli.ts",
    "llm:smoke": "tsx --conditions=react-server src/lib/llm/smoke.ts",
    "llm:smoke:jev": "tsx --conditions=react-server src/lib/llm/jev-smoke.ts",
    "scoring:calibrate": "tsx --conditions=react-server src/pipeline/scoring/calibrate.ts",
    "scoring:ab": "tsx --conditions=react-server src/pipeline/scoring/ab.ts",
    "scoring:visa-check": "tsx --conditions=react-server src/pipeline/scoring/visa-check.ts",
    "scoring:backfill": "tsx --conditions=react-server src/pipeline/backfill.ts",
    "resume:smoke": "tsx --conditions=react-server src/pipeline/resume/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/groq": "^4.0.48",
    "@ai-sdk/openai": "^4.0.75",
    "@node-rs/argon2": "^2.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.114",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "iconsax-reactjs": "^0.0.8",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
