# ─────────────────────────────────────────────────────────────────────────────
# Atlas environment — copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Values are validated by src/lib/env.ts (Zod). Booleans accept true/false/1/0.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required at M0 ───────────────────────────────────────────────────────────

# Local dev points at the Docker Postgres from docker-compose.yml (host port 5433).
# Production points this at Neon.
DATABASE_URL="postgres://atlas:atlas@localhost:5433/atlas"

# Signs the JWT session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app (used by Auth.js for callbacks).
APP_URL="http://localhost:3000"

# ── The single user (consumed ONLY by `npm run db:seed`; never stored in plaintext) ──
AUTH_USER_EMAIL="you@example.com"
AUTH_USER_PASSWORD="change-me-at-least-8-chars"
AUTH_USER_NAME="Atlas"

# ── Pipeline trigger (guards POST /api/pipeline/run; the cron uses this) ──────
# Generate with: openssl rand -hex 32.  If unset, the endpoint rejects everything.
PIPELINE_TRIGGER_SECRET=""

# ── Later milestones (safe to leave blank at M0; defaults keep the app booting) ──

# M2 — scoring & drafting.
# src/lib/llm is the ONLY module that reads these or knows a provider exists.
# Switching providers is a change to LLM_PROVIDER + the two model ids — nothing else.
#
#   provider   | scoring                | drafting                | key
#   -----------+------------------------+-------------------------+------------------
#   openai     | gpt-5-mini             | gpt-5-mini (or gpt-5.2) | OPENAI_API_KEY
#   google     | gemini-3.8-flash       | gemini-3.1-pro-preview  | GEMINI_API_KEY
#   groq       | qwen/qwen3.8-27b       | openai/gpt-oss-120b     | GROQ_API_KEY
#   anthropic  | claude-sonnet-5        | claude-opus-5           | ANTHROPIC_API_KEY
#
# Verify a switch with: npm run llm:smoke
#
# Default is OpenAI. Measured on a real 15-job run: 15/15 scored in 1m53s, 78% of
# input tokens served from OpenAI's automatic prompt cache, ~$0.005/job.
# The free tiers of the alternatives throttle a batch run hard — Gemini caps at
# 5 requests/min, Groq at 7k input tokens/min (~2 jobs/min at this prompt size).
# Both slots must be on the SAME provider; LLM_PROVIDER selects one.
LLM_PROVIDER="openai"
MODEL_SCORING="gpt-5-mini"
MODEL_DRAFTING="gpt-5-mini"

# Only the key for the selected LLM_PROVIDER is required; the rest can stay blank.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Parallel LLM calls per run, retries after the first attempt, and the wall clock on
# any single attempt — without a timeout a hung provider connection stalls a whole run.
LLM_MAX_CONCURRENCY="3"
LLM_MAX_RETRIES="2"
LLM_REQUEST_TIMEOUT_MS="60000"

# Login throttle. Argon2 makes each guess slow, but nothing bounded how many an
# attacker could make — and each allocates 19 MiB, so it was a cheap DoS too.
LOGIN_MAX_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"

# ── Notification (PRD §8 step 7) ─────────────────────────────────────────────
# Where the "N strong matches" run summary goes. Any endpoint that takes a POST —
# the body shape is chosen from the URL (Slack, Discord and ntfy each differ).
# Unset = no notification; the run still records itself on the Runs screen.
#   Slack    https://hooks.slack.com/services/...
#   Discord  https://discord.com/api/webhooks/...
#   ntfy     https://ntfy.sh/your-topic

# ── Ops ──────────────────────────────────────────────────────────────────────
TZ="UTC"
LOG_LEVEL="info"

# Postings older than this never enter the corpus (days). Widening it is safe:
# boards still list what they still have, so a re-run picks them up.
MAX_POSTING_AGE_DAYS=30

# --- Daily email -----------------------------------------------------------
# Get a key at https://resend.com/api-keys (free tier is ample for one email a day).
# Leave RESEND_API_KEY unset and no email is sent; the run still records everything.
RESEND_API_KEY=
# Where the daily email goes. With the default sender below this must be the address
# on your Resend account — sending anywhere else needs a verified domain.
NOTIFY_EMAIL_TO=
# Resend's shared sandbox sender. Replace once you have verified your own domain.
NOTIFY_EMAIL_FROM="Atlas <onboarding@resend.dev>"

# How many roles the day's queue offers, and the cap per employer.
DAILY_QUEUE_SIZE=20
MAX_PER_COMPANY=4
